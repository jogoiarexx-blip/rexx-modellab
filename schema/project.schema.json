{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Projeto e receita REXX ModelLab 1.0",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "\\S"
    },
    "units": {
      "const": "meters"
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/material"
      }
    },
    "parts": {
      "type": "array",
      "maxItems": 1500,
      "items": {
        "$ref": "#/$defs/part"
      }
    },
    "references": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/reference"
      }
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "units",
    "materials",
    "parts"
  ],
  "$defs": {
    "material": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,96}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "color": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "roughness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "metalness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "baseColorImage": {
          "type": "string",
          "pattern": "^data:image/jpeg;base64,/9j/",
          "maxLength": 6000000
        }
      },
      "required": [
        "id",
        "name",
        "color",
        "roughness",
        "metalness"
      ]
    },
    "part": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,96}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "parent": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,96}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "shape": {
          "enum": [
            "box",
            "case",
            "cylinder",
            "sphere",
            "cone",
            "torus",
            "mesh",
            "group",
            "profile"
          ]
        },
        "material": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,96}$"
        },
        "position": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          }
        },
        "rotation": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          }
        },
        "scale": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 0.00001,
            "maximum": 10000
          }
        },
        "size": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 0.00001,
            "maximum": 10000
          }
        },
        "geometry": {
          "$ref": "#/$defs/geometry"
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "origin": {
          "enum": [
            "single-view-extrusion",
            "single-view-humanoid",
            "two-view-humanoid"
          ]
        },
        "sideCalibrated": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "parent",
        "shape",
        "material",
        "position",
        "rotation",
        "scale",
        "size"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "shape": {
                "const": "mesh"
              }
            }
          },
          "then": {
            "required": [
              "geometry"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "shape": {
                "const": "profile"
              }
            }
          },
          "then": {
            "required": [
              "profile"
            ]
          }
        }
      ]
    },
    "geometry": {
      "type": "object",
      "properties": {
        "positions": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "minItems": 9
        },
        "normals": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          }
        },
        "uv": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          }
        },
        "indices": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": [
        "positions"
      ]
    },
    "reference": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,96}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "image": {
          "type": "string",
          "pattern": "^data:image/jpeg;base64,/9j/",
          "maxLength": 3700000
        }
      },
      "required": [
        "id",
        "name",
        "width",
        "height",
        "image"
      ]
    },
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 2048
      }
    },
    "profile": {
      "type": "object",
      "properties": {
        "reference": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,96}$"
        },
        "points": {
          "type": "array",
          "minItems": 3,
          "maxItems": 192,
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "calibration": {
          "type": "object",
          "properties": {
            "a": {
              "$ref": "#/$defs/point"
            },
            "b": {
              "$ref": "#/$defs/point"
            },
            "meters": {
              "type": "number",
              "minimum": 0.00001,
              "maximum": 10000
            }
          },
          "required": [
            "a",
            "b",
            "meters"
          ]
        },
        "form": {
          "enum": [
            "rigid",
            "humanoid"
          ]
        },
        "volume": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1.5
        },
        "back": {
          "type": "object",
          "properties": {
            "reference": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,96}$"
            },
            "points": {
              "type": "array",
              "minItems": 3,
              "maxItems": 192,
              "items": {
                "$ref": "#/$defs/point"
              }
            },
            "alignment": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 1
                }
              }
            }
          },
          "required": [
            "reference",
            "points"
          ]
        },
        "side": {
          "type": "object",
          "properties": {
            "reference": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,96}$"
            },
            "points": {
              "type": "array",
              "minItems": 3,
              "maxItems": 192,
              "items": {
                "$ref": "#/$defs/point"
              }
            },
            "facing": {
              "enum": [
                "left",
                "right"
              ]
            },
            "alignment": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 1
                }
              }
            }
          },
          "required": [
            "reference",
            "points",
            "facing"
          ]
        },
        "detail": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "reference",
        "points"
      ]
    }
  }
}
